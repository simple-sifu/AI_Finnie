# Copy this file to .env and fill in your keys. Never commit .env.

# Required
OPENAI_API_KEY=
ALPHA_VANTAGE_API_KEY=
SERPAPI_API_KEY=

# Optional: only required if news.provider is set to tavily
TAVILY_API_KEY=

# Optional overrides (defaults shown)
OPENAI_MODEL=gpt-4o-mini
MARKET_DATA_MODE=live            # live | mock
QUOTE_CACHE_TTL_SECONDS=1800     # 30 minutes
